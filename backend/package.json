{
  "name": "dsaforge-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "verify:problems": "node --env-file-if-exists=.env scripts/verify-problems.js",
    "missing": "node scripts/list-missing.js",
    "test:sandbox": "node --env-file-if-exists=.env scripts/test-sandbox.js",
    "test:github": "node --env-file-if-exists=.env scripts/test-github-sync.js"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "js-yaml": "^5.4.2",
    "mongoose": "^9.10.1"
  }
}

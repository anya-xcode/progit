PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/dsaforge
CLIENT_URL=http://localhost:5174

# Code execution sandbox
#   namespace = Linux namespace jail (through WSL on Windows, no Docker needed)
#   docker    = one container per run (build the image first, see README)
#   judge0    = remote Judge0 server (for deployments that cannot sandbox, e.g. Vercel)
#   piston    = remote Piston server (self-hosted; the public API is whitelist-only)
EXECUTION_PROVIDER=namespace
WSL_DISTRO=Ubuntu
# DOCKER_COMMAND=docker
# DOCKER_COMMAND=wsl -d Ubuntu docker
# JUDGE0_URL=https://judge0.example.com
# JUDGE0_TOKEN=
# JUDGE0_LANGUAGE_ID=71
# PISTON_URL=http://localhost:2000/api/v2
EXECUTION_TIME_LIMIT_MS=2000
EXECUTION_MEMORY_LIMIT_MB=256
EXECUTION_OUTPUT_LIMIT_KB=256
EXECUTION_MAX_CONCURRENT=2

# Deployment (see docs/DEPLOYMENT.md)
# A shared password for the whole app; required on every /api request when set.
# APP_ACCESS_KEY=
# Skip the library upsert at boot (seed once with `npm run seed` instead).
# SKIP_LIBRARY_SYNC=true

# GitHub sync — server-side only, never sent to the frontend. Use ONE option:
# Option A (simplest): a fine-grained personal access token with
#   Repository access: your solutions repo (or all repos to create one from the app)
#   Permissions: Contents = Read and write, Metadata = Read
#   (Administration = Read and write only if you want to create repos from DSAForge)
# GITHUB_TOKEN=
# Option B: a GitHub OAuth App (Settings → Developer settings → OAuth Apps) with
#   Authorization callback URL = http://localhost:5174/api/github/oauth/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
